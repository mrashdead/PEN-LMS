COMPOSE_PROJECT_NAME=pen
PEN_ENV_FILE=.env.docker
APP_IMAGE=pen-app:local
PYTHON_IMAGE=python:3.11-slim-bookworm
NODE_IMAGE=node:22-bookworm-slim
POSTGRES_IMAGE=postgres:18-bookworm
REDIS_IMAGE=redis:8-bookworm
CADDY_IMAGE=caddy:2-alpine

DEBUG=False
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=pen
TEST_DB_NAME=test_pen
DB_USER=pen
DB_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
DB_CONN_MAX_AGE=60

SITE_ADDRESS=http://localhost
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
TOKEN_EXPIRY_DAYS=90

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
CELERY_CONCURRENCY=2
TIME_ZONE=Asia/Tehran
LANGUAGE_CODE=fa-ir

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL='Pen LMS <noreply@example.com>'
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER=
SLA_REMINDER_LEAD_HOURS=4
SLA_ESCALATION_ROLE=manager
