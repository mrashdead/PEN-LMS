# Copy to .env for local development. Never commit .env.
DEBUG=True
SECRET_KEY=change-me-in-local-env
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pen
DB_USER=pen
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Security
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=False
TOKEN_EXPIRY_DAYS=90
SECURE_SSL_REDIRECT=False

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Email (outbox worker). In DEBUG the default is the console backend; for
# production set EMAIL_BACKEND to smtp and fill the host credentials.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Pen LMS <noreply@example.com>

# Parent report SMS (provider-neutral JSON endpoint)
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER=

# SLA defaults (scan_sla command / Celery beat task)
SLA_REMINDER_LEAD_HOURS=4
SLA_ESCALATION_ROLE=manager

# Timezone
TIME_ZONE=Asia/Tehran
LANGUAGE_CODE=fa-ir

# Forms security fallbacks. Production MUST keep this False and install the
# real libraries (bleach, python-magic + libmagic). Set True ONLY in a local
# dev/test environment that cannot install them; the Django system checks then
# downgrade forms.E001/E002 to warnings. DEBUG alone never enables this.
FORMS_ALLOW_SECURITY_FALLBACKS=False
